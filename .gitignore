__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# run artifacts stay local: metrics are small but state.pt and adapters are not
runs/*
!runs/.gitkeep
*.tmp

# regenerated by analysis/*.py from runs/ (which is git-ignored), so it cannot
# be a source of truth: the source of truth is runs/*/metrics.jsonl
analysis/out/

# downloaded weights / calibration outputs that depend on the machine
data/calibration_*.json
data/prompts_band.jsonl
data/prompts_band.MANIFEST.json
