__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# run artifacts stay local: metrics are small but state.pt and adapters are not
runs/*
!runs/.gitkeep

# 例外：9 个正式 run 的指标/样本/摘要进 git（合计约 1.3 MB），
# 目的是让陌生人不需要 GPU、不需要重训，就能复算 REPORT 里的每个数字。
# 大件（state.pt 837 MB、adapters/、rollouts/*.npz）仍然只在本地。
!runs/mu*/
runs/mu*/*
!runs/mu*/metrics.jsonl
!runs/mu*/samples.jsonl
!runs/mu*/summary.json
!runs/mu*/run_meta.json
!runs/mu*/config.resolved.yaml

*.tmp

# regenerated by analysis/*.py from runs/ (which is git-ignored), so it cannot
# be a source of truth: the source of truth is runs/*/metrics.jsonl
analysis/out/

# downloaded weights / calibration outputs that depend on the machine
data/calibration_*.json
data/prompts_band.jsonl
data/prompts_band.MANIFEST.json

# SAC-µ 判读输入入仓（约 10 MB，无大件）：陌生人 clone 后无需 GPU 即可复算四表。
!runs_sac/
!runs_fixed/
# µ16 重打分基线（rescore_mu16.py 的确定性产物；npz 本地重建属离线验证）
!analysis/out/
analysis/out/*
!analysis/out/mu16_rescored_r6r7.json
